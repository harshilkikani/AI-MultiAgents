# Lead Revival — backend env template
# Copy to .env and fill in real values when ready to leave DEMO_MODE.

# Core
DEMO_MODE=true
DATABASE_URL=sqlite:///./revival.db
CORS_ORIGINS=http://localhost:5174

# Anthropic (generation + reply classification)
ANTHROPIC_API_KEY=

# Twilio (SMS send + receive)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Stripe (billing)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ONE_SHOT=
STRIPE_PRICE_MONTHLY=

# Calendly webhook signing secret (set in Calendly admin when creating the
# webhook subscription). Leave blank in DEMO_MODE.
CALENDLY_WEBHOOK_SECRET=
